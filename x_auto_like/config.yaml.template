# X API Credentials (Fill these in your local environment)
api:
  client_id: "YOUR_CLIENT_ID"
  client_secret: "YOUR_CLIENT_SECRET"
  access_token: "YOUR_ACCESS_TOKEN"
  access_token_secret: "YOUR_ACCESS_TOKEN_SECRET"
  bearer_token: "YOUR_BEARER_TOKEN"

settings:
  max_likes_per_run: 30
  sleep_min: 2
  sleep_max: 5
  max_results_per_user: 5
  log_file: "logs/auto_like.log"
  db_file: "liked_tweets.db"
  cleanup_days: 30

target_accounts:
  - "example_user"
